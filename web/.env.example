# Local env for the web app. Copy to .env.local (gitignored) if you change the API URL.
# Server-side URL the Next.js proxy route uses to reach the FastAPI backend.
# Single URL, OR a comma-separated list for failover across machines (the proxy
# tries each in order and uses whichever is up). Run only ONE backend at a time.
#   e.g. STOCK_MONITOR_API_URL=https://mac-a.tailnet.ts.net,https://intel-mac.tailnet.ts.net
STOCK_MONITOR_API_URL=http://127.0.0.1:8137
# Shared secret forwarded to the backend as `X-API-Key`. Leave blank locally; in
# production set it to the SAME value as the backend's API_SHARED_SECRET.
STOCK_MONITOR_API_KEY=
