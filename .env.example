# Copy to .env (gitignored) and fill in. Never commit real secrets.
# Every configurable env var is listed here; uncomment/change what you need.

# ── Data sources ───────────────────────────────────────────────────────────
# SEC EDGAR requires a descriptive User-Agent with contact info per its fair-access policy.
# HOW TO GET: no signup — just use your app name + YOUR real email so the SEC can
# contact you. Format: "AppName/Version (contact-email)"
SEC_USER_AGENT="Stock-Monitor/0.1 (you@example.com)"
# Optional: Finnhub free API key → cleaner company news + (later) earnings calendar.
# When set, Finnhub is used for news instead of yfinance.
# HOW TO GET: register free at https://finnhub.io/register → the dashboard shows your
# API key (free tier = 60 requests/min, US coverage). Paste it below.
FINNHUB_API_KEY=""

# Optional: Alpha Vantage free key → historical news gap backfill (NEWS_SENTIMENT).
# HOW TO GET: https://www.alphavantage.co/support/#api-key (free tier = 25 req/day).
ALPHAVANTAGE_API_KEY=""

# Optional: FRED free key → point-in-time macro/regime features (rates, inflation,
# yield curve, unemployment, credit spread). Vintage-aware, so no look-ahead.
# HOW TO GET: create a free account at https://fredaccount.stlouisfed.org/apikeys →
# "Request API Key". Free, instant, ~120 req/min, no daily cap.
FRED_API_KEY=""

# ── Model / labels ─────────────────────────────────────────────────────────
# Forward-return label window in months. Phase 0 default = 12 (cleaner long-term signal).
LABEL_WINDOW_MONTHS=12
# Secondary near-term model horizon (months).
LABEL_WINDOW_MONTHS_SHORT=3

# ── News / sentiment ───────────────────────────────────────────────────────
# How many days of headlines to pull per ticker (your choice; no signup).
NEWS_LOOKBACK_DAYS=7
# Aggregate sentiment below this = "material negative news" (tips a holding toward sell).
SENTIMENT_NEGATIVE_THRESHOLD=-0.25
# "vader" (default, no heavy deps) or "finbert" (finance-trained, better).
# HOW TO ENABLE FINBERT: run `pip install -e ".[finbert]"` (downloads transformers +
# torch; the model auto-downloads on first use), then set this to finbert.
SENTIMENT_BACKEND="vader"

# ── Alerts (Telegram) ──────────────────────────────────────────────────────
# Leave blank to fall back to a logging notifier (no secrets needed).
# HOW TO GET THE TOKEN: in Telegram, open a chat with @BotFather → send /newbot →
# follow the prompts → it replies with your bot token. Paste it below.
TELEGRAM_BOT_TOKEN=""
# HOW TO GET THE CHAT ID: send your new bot any message, then open
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and copy result[0].message.chat.id
# (or DM @userinfobot on Telegram to get your personal chat id).
TELEGRAM_CHAT_ID=""
# Alert when a name newly crosses this calibrated conviction.
ALERT_CONVICTION_THRESHOLD=70

# ── LLM analyst (OpenRouter, optional) ────────────────────────────────────
# Set OPEN_ROUTER_API_KEY and enable the optional AI second opinion/explainer.
OPEN_ROUTER_API_KEY=""
LLM_ANALYST_ENABLED=false
LLM_MODEL="openai/gpt-5.6-luna"
LLM_EXPLAIN_MODEL="openai/gpt-4o-mini"
LLM_BASE_URL="https://openrouter.ai/api/v1"

# ── API auth ───────────────────────────────────────────────────────────────
# Shared secret that protects the API when it is exposed on the public internet
# (e.g. the Oracle VM). Empty = auth disabled (fine for localhost-only dev).
# When set, callers must send it as the `X-API-Key` header; set the SAME value as
# STOCK_MONITOR_API_KEY in the web app so its server-side proxy can reach the API.
# HOW TO GET: generate a random string yourself, e.g. `openssl rand -hex 32`.
API_SHARED_SECRET=""

# ── Scheduler / heartbeat ──────────────────────────────────────────────────
# Timezone used by all scheduled jobs (handles daylight saving automatically).
SCHEDULER_TIMEZONE="America/Chicago"
# Local hour (0-23) for the daily universe scan.
SCAN_HOUR=22
# Alert if no successful scan lands within this many hours.
HEARTBEAT_MAX_AGE_HOURS=26
# Run the scheduler in-process with the API. Set 1 in production/containers so a
# single process owns DuckDB (leave 0 locally and use `stock-monitor-scheduler`).
RUN_SCHEDULER=0

# ── Infra / storage (usually leave as defaults) ────────────────────────────
# HTTP cache TTL in seconds (politeness + free-tier rate-limit safety). Default 24h.
HTTP_CACHE_TTL=86400
# DB_PATH="data/stock_monitor.duckdb"
# MODEL_PATH="models/latest.joblib"
# MODEL_PATH_SHORT="models/latest_3m.joblib"
# MLFLOW_TRACKING_URI="file:./mlruns"
# MLFLOW_EXPERIMENT="stock-monitor"
